# Required: migrated MySQL/TiDB database and Google OAuth
DATABASE_URL=
SESSION_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Optional; defaults to the request origin + /api/auth/google/callback
GOOGLE_CALLBACK_URL=
# Optional; TiDB Cloud always uses verified TLS, even without this flag
DATABASE_SSL=
# Optional legacy fallback when SESSION_SECRET is not set
JWT_SECRET=

# Required for video uploads/playback. Server-only; never prefix these with VITE_.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=

# Optional: enables the authenticated daily Vercel video cleanup cron
CRON_SECRET=

# Optional local server port
PORT=3000

# Frontend branding (public values)
VITE_APP_TITLE=WaveShare 浪旅誌
VITE_APP_LOGO=
