# Required: migrated MySQL/TiDB database and Manus OAuth
DATABASE_URL=
JWT_SECRET=
VITE_APP_ID=
OAUTH_SERVER_URL=
VITE_OAUTH_PORTAL_URL=

# Required for video uploads/playback. Server-only; never prefix these with VITE_.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_URL=

# Optional: enables the authenticated daily Vercel video cleanup cron
CRON_SECRET=

# Optional owner/admin and local server port
OWNER_OPEN_ID=
PORT=3000

# Frontend branding and optional analytics (public values)
VITE_APP_TITLE=WaveShare 浪旅誌
VITE_APP_LOGO=
VITE_ANALYTICS_ENDPOINT=
VITE_ANALYTICS_WEBSITE_ID=

# Optional Manus scaffold services (notifications / image generation / AI)
BUILT_IN_FORGE_API_URL=
BUILT_IN_FORGE_API_KEY=
# Only for the unused Google Maps scaffold; not required by Leaflet or R2
VITE_FRONTEND_FORGE_API_URL=
VITE_FRONTEND_FORGE_API_KEY=
